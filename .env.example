# My Virtual World: configuration of an installation.
#
# Every setting is an environment variable, set in the service's own environment: Environment= or EnvironmentFile= in
# a systemd unit, or the environment section of compose.yaml. The server itself never reads a .env file; Docker
# Compose reads one next to compose.yaml for the values compose.yaml passes on.
#
# To use this file, copy it, remove the # in front of each setting you change and edit its value. Keep comments on
# their own lines: systemd does not allow a comment after a value. An invalid value stops the start with a message
# that lists every problem at once.

# ---------------------------------------------------------------------------------------------------- server

# The port and address the server listens on. 0.0.0.0 accepts connections from other machines; 127.0.0.1 only from
# this machine, which suits a reverse proxy on the same machine. The Docker image sets both.
# PORT=8570
# HOST=0.0.0.0

# The data folder (world files and the accounts database), as an absolute path. Without it, the folder named data in
# the code folder is used, which suits a development checkout only. The Docker image uses /data.
# MVW_DATA=/var/lib/my-virtual-world/data

# The key for stored secrets, such as two-factor sign-in secrets. Required: set exactly one of MVW_KEY_FILE and
# MVW_SECRET_KEY.
# MVW_KEY_FILE is the absolute path of a key file outside the data folder; the server creates it at the first start.
# Back the key up separately: backups and copies of the data folder leave it out on purpose. The Docker image uses
# /keys/secret.key on a volume of its own.
# MVW_SECRET_KEY is the key itself (44 characters of base64). Other programs run by the same user can read a
# process's environment, so a key file is safer. MVW_SECRET_KEY_PREVIOUS is the key before a rotation, needed while
# values sealed with it remain.
# MVW_KEY_FILE=/var/lib/my-virtual-world/keys/secret.key
# MVW_SECRET_KEY=
# MVW_SECRET_KEY_PREVIOUS=
# How often, in milliseconds, the key file is checked for a rotation.
# MVW_KEY_POLL_MS=2000

# The address or addresses people open, comma-separated. When set, only these sites may change anything.
# MVW_PUBLIC_URL=https://world.example.org

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers are believed: addresses or subnets,
# comma-separated, or none. For a proxy on this machine: 127.0.0.1,::1. compose.yaml sets it to MVW_PROXY_IP.
# MVW_TRUSTED_PROXIES=none

# The session cookie's name. It must start with __Host-. Two installations under one host name need different names.
# MVW_COOKIE_NAME=__Host-mvw-session

# 1 only in the Docker image: connections from the container's default gateway count as this machine, so the owner
# can sign in over plain HTTP at http://localhost. Signing in from other machines always needs HTTPS.
# MVW_GATEWAY_IS_LOCAL=0

# A new city, generated when the data folder holds no world yet: its residents, the random seed, and the name of the
# starter city's headquarters (at most 28 characters; admins can rename it later).
# MVW_POPULATION=1000
# How many live in the city follows its homes (Settings → Residents → Homes filled). off: the first start makes exactly
# MVW_POPULATION residents and the number stays as it is (no one moves in or away by themselves).
# MVW_HOUSING=on
# A new world opens with the starting map built for new installations; off: a city generated from MVW_SEED, sized by
# MVW_POPULATION.
# MVW_STARTER_MAP=on
# The game's own soundtrack goes into the music library when the server starts (each song once; one an administrator
# deletes stays deleted). off: the library is left alone.
# MVW_SOUNDTRACK=on
# MVW Radio's hosts write and read their breaks (Settings → Radio). off: no breaks are written (music and idents still play).
# MVW_RADIO=on
# MVW_SEED=next-city
# MVW_HQ_NAME=Headquarters

# Tests only: 1 loads the mock agent provider into the provider helper (it never appears in a real installation), and
# MVW_PROVIDER_RUN_TIMEOUT_MS shortens how long a run request may go unanswered (milliseconds).
# MVW_PROVIDER_TEST=0
# MVW_PROVIDER_RUN_TIMEOUT_MS=30000
# Tests only (with MVW_PROVIDER_TEST=1): the address of a fake Twilio on this machine (http://127.0.0.1:<port>) for agents' phones.
# MVW_TWILIO_TEST_URL=

# Live world stream connections per client address, and in total.
# MVW_WS_PER_ADDRESS=20
# MVW_WS_MAX=1000
# Disk space (MB) for the media of agent providers' answers shown in the chat window.
# MVW_PROVIDER_MEDIA_CACHE_MB=1024

# How often (milliseconds) the AI agents' lives are looked at for problems — rent they couldn't pay, money running out, no
# home, no job — that their owners are told about and their Minds think about. A problem opens after two looks in a row.
# MVW_PROBLEM_SCAN_MS=15000

# The agents' built-in real browser: the Chrome it runs (a path), or "off" for the text reader only. Unset: a Chrome or
# Chromium installed on this machine (Google Chrome on Ubuntu has what its page sandbox needs).
# MVW_CHROME=

# ---------------------------------------------------------------------------------------------------- Docker Compose only

# The image compose.yaml builds and runs.
# MVW_IMAGE=my-virtual-world:2

# The port on this machine where the app is published, on the loopback address only.
# MVW_PORT=8570

# The optional reverse proxy (docs/INSTALL.md): the domain it gets a certificate for, and its ports.
# MVW_DOMAIN=world.example.org
# MVW_HTTP_PORT=80
# MVW_HTTPS_PORT=443
# Its network: Docker gives containers addresses from MVW_PROXY_RANGE only, and the proxy keeps the fixed address
# MVW_PROXY_IP outside that range, which the app trusts. If the subnet is taken on your machine ("Pool overlaps"),
# change the three together.
# MVW_PROXY_SUBNET=10.87.70.0/28
# MVW_PROXY_RANGE=10.87.70.0/29
# MVW_PROXY_IP=10.87.70.10
