# Configuration for tools/deploy/*.sh (native install run by systemd).
# Copy to ~/.config/mvw-next/deploy.env, or point MVW_DEPLOY_ENV at another file, and adjust the paths.
# No secrets belong in this file.

# Git checkout that holds the release tags.
MVW_REPO=/srv/my-virtual-world/repo
# Installation root: releases/, current, previous, data/, backups/, logs/, promotions.log
MVW_LIVE_ROOT=/srv/my-virtual-world/live
# systemd unit that runs $MVW_LIVE_ROOT/current (WorkingDirectory) with MVW_DATA=$MVW_LIVE_ROOT/data
MVW_LIVE_UNIT=my-virtual-world.service
# Where the smoke test reaches the live server (the local port, not the public HTTPS address).
MVW_LIVE_URL=http://127.0.0.1:8570
# "systemctl --user" for a user unit, "sudo systemctl" for a system unit.
MVW_SYSTEMCTL="systemctl --user"

# Optional staging copy (used by staging-refresh.sh): its data/ and logs/ live under MVW_STAGING_ROOT.
MVW_STAGING_ROOT=/srv/my-virtual-world/staging
MVW_STAGING_UNIT=my-virtual-world-staging.service
MVW_STAGING_URL=http://127.0.0.1:8571

# Seconds a new release gets to pass its smoke test before it is rolled back.
MVW_SMOKE_TIMEOUT=90

# 1 = before a promotion, also run the new release's real-browser UI test (tools/uitest.cjs) on a throwaway server
# with a copy of the live data; live is not touched when it fails. Needs Google Chrome (or MVW_TEST_BROWSER) and the
# repository's dev dependencies (npm ci in MVW_REPO). MVW_TEST_NODE_PATH is their node_modules folder.
MVW_PROMOTE_UITEST=0
MVW_TEST_NODE_PATH=/srv/my-virtual-world/repo/node_modules

# Retention: releases (current and previous are always kept) and data backups.
MVW_KEEP_RELEASES=5
MVW_KEEP_BACKUPS=30
